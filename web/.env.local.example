# Create a project at https://supabase.com, then copy these from
# Project Settings > API, and save this file as .env.local (gitignored).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret for admin account actions (reset password, deactivate,
# delete). Project Settings > API Keys: the service_role key (or a secret key).
# Never add a NEXT_PUBLIC_ prefix — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
